<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Aparta_Suites_UQ.viewController.recepcion.InterfazCheckController">
    <children>
        <!-- BARRA LATERAL IZQUIERDA -->
        <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="650.0" prefWidth="235.0" styleClass="barra_lateral" stylesheets="@../../css/HojaEstilos.css">
            <children>
                <Pane layoutX="18.0" layoutY="21.0" prefHeight="81.0" prefWidth="200.0">
                    <children>
                        <Label layoutX="90.0" layoutY="14.0" prefHeight="35.0" prefWidth="112.0" stylesheets="@../../css/HojaEstilos.css" text="Aparta Suites">
                            <font>
                                <Font name="Loma Bold" size="18.0" />
                            </font>
                        </Label>
                        <Label layoutX="125.0" layoutY="41.0" text="UQ">
                            <font>
                                <Font name="Loma Bold" size="18.0" />
                            </font>
                        </Label>
                        <ImageView fitHeight="57.0" fitWidth="54.0" layoutX="19.0" layoutY="13.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../image/logo.png" />
                            </image>
                        </ImageView>
                    </children>
                </Pane>

                <Pane layoutX="2.0" layoutY="136.0" prefHeight="53.0" prefWidth="234.0">
                    <children>
                        <Button fx:id="buttom_inicioRecepcion" layoutX="14.0" layoutY="7.0" mnemonicParsing="false" onAction="#mostrarPanelInicioRecepcion" onMouseEntered="#vistaMouseEncimaInicio" onMouseExited="#vistaMouseAfueraInicio" prefHeight="40.0" prefWidth="221.0" styleClass="buttom-action" stylesheets="@../../css/HojaEstilos.css" />
                        <Rectangle fx:id="rect_inicio_buttom" arcHeight="5.0" arcWidth="5.0" fill="#7279b5" height="39.0" layoutX="3.0" layoutY="8.0" stroke="#7279b5" strokeType="INSIDE" visible="false" width="4.0" />
                        <ImageView disable="true" fitHeight="30.0" fitWidth="31.0" layoutX="25.0" layoutY="12.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../image/casita.png" />
                            </image>
                        </ImageView>
                        <Label disable="true" layoutX="65.0" layoutY="6.0" prefHeight="40.0" prefWidth="151.0" stylesheets="@../../css/HojaEstilos.css" text="Inicio">
                            <font>
                                <Font size="20.0" />
                            </font>
                            <styleClass>
                                <String fx:value="roboto-texto" />
                                <String fx:value="opacitylbl" />
                            </styleClass>
                        </Label>
                    </children>
                </Pane>

                <Pane layoutX="2.0" layoutY="189.0" prefHeight="53.0" prefWidth="234.0">
                    <children>
                        <Button fx:id="buttom_Check" layoutX="14.0" layoutY="7.0" mnemonicParsing="false" onAction="#mostrarPanelCheck" onMouseEntered="#vistaMouseEncimaCheck" onMouseExited="#vistaMouseAfueraCheck" prefHeight="40.0" prefWidth="221.0" styleClass="buttom-action" stylesheets="@../../css/HojaEstilos.css" />
                        <Rectangle fx:id="rect_check_buttom" arcHeight="5.0" arcWidth="5.0" fill="#7279b5" height="39.0" layoutX="3.0" layoutY="8.0" stroke="#7279b5" strokeType="INSIDE" visible="true" width="4.0" />
                        <Label disable="true" layoutX="65.0" layoutY="13.0" prefHeight="27.0" prefWidth="120.0" stylesheets="@../../css/HojaEstilos.css" text="Check in/out">
                            <font>
                                <Font size="18.0" />
                            </font>
                            <styleClass>
                                <String fx:value="opacitylbl" />
                                <String fx:value="roboto-texto" />
                            </styleClass>
                        </Label>
                        <ImageView disable="true" fitHeight="28.0" fitWidth="28.0" layoutX="25.0" layoutY="16.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../image/Lupa.png" />
                            </image>
                        </ImageView>
                    </children>
                </Pane>

                <Pane layoutX="1.0" layoutY="252.0" prefHeight="53.0" prefWidth="234.0">
                    <children>
                        <Button fx:id="buttom_folio" layoutX="14.0" layoutY="7.0" mnemonicParsing="false" onAction="#mostrarPanelFolio" onMouseEntered="#vistaMouseEncimaFolio" onMouseExited="#vistaMouseAfueraFolio" prefHeight="40.0" prefWidth="221.0" styleClass="buttom-action" stylesheets="@../../css/HojaEstilos.css" />
                        <Rectangle fx:id="rect_folio_buttom" arcHeight="5.0" arcWidth="5.0" fill="#7279b5" height="39.0" layoutX="3.0" layoutY="8.0" stroke="#7279b5" strokeType="INSIDE" visible="false" width="4.0" />
                        <Label disable="true" layoutX="66.0" layoutY="12.0" stylesheets="@../../css/HojaEstilos.css" text="Folio">
                            <font>
                                <Font size="20.0" />
                            </font>
                            <styleClass>
                                <String fx:value="roboto-texto" />
                                <String fx:value="opacitylbl" />
                            </styleClass>
                        </Label>
                        <ImageView disable="true" fitHeight="23.0" fitWidth="33.0" layoutX="25.0" layoutY="13.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../image/folio.png" />
                            </image>
                        </ImageView>
                    </children>
                </Pane>

                <Pane layoutX="1.0" layoutY="306.0" prefHeight="53.0" prefWidth="234.0">
                    <children>
                        <Button fx:id="buttom_apartamento" layoutX="16.0" layoutY="6.0" mnemonicParsing="false" onAction="#mostrarPanelApartamento" onMouseEntered="#vistaMouseEncimaApartamento" onMouseExited="#vistaMouseAfueraApartamento" prefHeight="40.0" prefWidth="220.0" styleClass="buttom-action" stylesheets="@../../css/HojaEstilos.css" />
                        <Rectangle fx:id="rect_apartamento_buttom" arcHeight="5.0" arcWidth="5.0" fill="#7279b5" height="39.0" layoutX="3.0" layoutY="8.0" stroke="#7279b5" strokeType="INSIDE" visible="false" width="4.0" />
                        <Label disable="true" layoutX="67.0" layoutY="15.0" text="Apartamentos">
                            <font>
                                <Font size="18.0" />
                            </font>
                            <styleClass>
                                <String fx:value="roboto-texto" />
                                <String fx:value="opacitylbl" />
                            </styleClass>
                        </Label>
                        <ImageView disable="true" fitHeight="40.0" fitWidth="80.0" layoutX="23.0" layoutY="7.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../image/apartamento.png" />
                            </image>
                        </ImageView>
                    </children>
                </Pane>

                <Pane layoutY="360.0" prefHeight="53.0" prefWidth="234.0">
                    <children>
                        <Button fx:id="buttom_reservaDirecta" layoutX="14.0" layoutY="7.0" mnemonicParsing="false" onAction="#mostrarPanelReserva" onMouseEntered="#vistaMouseEncimaReserva" onMouseExited="#vistaMouseAfueraReserva" prefHeight="40.0" prefWidth="221.0" styleClass="buttom-action" stylesheets="@../../css/HojaEstilos.css" />
                        <Rectangle fx:id="rect_reserva_buttom" arcHeight="5.0" arcWidth="5.0" fill="#7279b5" height="39.0" layoutX="3.0" layoutY="8.0" stroke="#7279b5" strokeType="INSIDE" visible="false" width="4.0" />
                        <ImageView disable="true" fitHeight="30.0" fitWidth="31.0" layoutX="25.0" layoutY="12.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../image/reserva.png" />
                            </image>
                        </ImageView>
                        <Label disable="true" layoutX="65.0" layoutY="6.0" prefHeight="40.0" prefWidth="151.0" stylesheets="@../../css/HojaEstilos.css" text="Reserva directa">
                            <font>
                                <Font size="20.0" />
                            </font>
                            <styleClass>
                                <String fx:value="roboto-texto" />
                                <String fx:value="opacitylbl" />
                            </styleClass>
                        </Label>
                    </children>
                </Pane>
            </children>
        </AnchorPane>

        <!-- CONTENIDO PRINCIPAL (DERECHA) -->
        <VBox layoutX="245.0" layoutY="10.0" prefHeight="630.0" prefWidth="945.0" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-padding: 15;">
            <children>
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Recepción: Registro de Check-In y Check-Out" />

                <!-- BARRA DE BÚSQUEDA Y FILTRADO -->
                <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Buscar Código/Titular:" />
                        <TextField fx:id="txtBuscarReserva" onKeyTyped="#onFiltrarReservas" prefWidth="250.0" promptText="Ingrese código o nombre..." styleClass="textField3" stylesheets="@../../css/HojaEstilos.css" />
                        <Label style="-fx-font-weight: bold;" text="Filtrar Estado:" />
                        <ComboBox fx:id="cmbFiltroEstado" onAction="#onFiltrarReservas" prefWidth="180.0" promptText="Todos" styleClass="comboBox" stylesheets="@../../css/HojaEstilos.css" />
                        <Button onAction="#onRefrescarLista" style="-fx-background-color: #64748b; -fx-text-fill: white;" styleClass="buttom_check" stylesheets="@../../css/HojaEstilos.css" text="Actualizar" />
                    </children>
                </HBox>

                <!-- VISTA DIVIDIDA: TABLA RESERVAS + DETALLES Y ACCIONES -->
                <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- TABLA DE RESERVAS -->
                        <TableView fx:id="tblReservas" stylesheets="@../../css/HojaEstilos.css" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
                                <TableColumn fx:id="colTitular" prefWidth="180.0" text="Huésped Titular" />
                                <TableColumn fx:id="colApartamento" prefWidth="140.0" text="Apartamento" />
                                <TableColumn fx:id="colEntrada" prefWidth="110.0" text="Entrada" />
                                <TableColumn fx:id="colSalida" prefWidth="110.0" text="Salida" />
                                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado Reserva" />
                            </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                        </TableView>

                        <!-- PANEL DERECHO DE DETALLE Y ACCIONES DE RECEPCIÓN -->
                        <VBox prefWidth="300.0" spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 6; -fx-border-color: #e2e8f0; -fx-border-radius: 6;">
                            <children>
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" text="Detalles de Operación" />
                                <Separator />

                                <VBox spacing="8.0">
                                    <children>
                                        <Label fx:id="lblCodigoReserva" style="-fx-font-weight: bold;" text="Reserva: --" />
                                        <Label fx:id="lblEstadoApto" text="Estado Apt: --" />
                                        <Label fx:id="lblSaldoFolio" style="-fx-font-weight: bold;" text="Saldo Folio: --" />
                                    </children>
                                </VBox>

                                <Separator />

                                <!-- ACCIONES PRINCIPALES -->
                                <VBox alignment="CENTER" prefHeight="304.0" prefWidth="197.0" spacing="10.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Button fx:id="btnCheckIn" onAction="#onRealizarCheckIn" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" styleClass="buttom_check" stylesheets="@../../css/HojaEstilos.css" text="Registrar CHECK-IN" />
                                        <Button fx:id="btnCheckOut" onAction="#onRealizarCheckOut" prefHeight="40.0" prefWidth="250.0" style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" styleClass="buttom_check" stylesheets="@../../css/HojaEstilos.css" text="Registrar CHECK-OUT" />
                                        <Button fx:id="btnNoShow" onAction="#onDeclararNoShow" prefHeight="35.0" prefWidth="250.0" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="buttom_check" stylesheets="@../../css/HojaEstilos.css" text="Declarar NO-SHOW" />
                                        <Separator />
                                        <Button onAction="#onIrAFolio" prefHeight="35.0" prefWidth="250.0" style="-fx-background-color: #d97706; -fx-text-fill: white; -fx-font-weight: bold;" styleClass="buttom_check" stylesheets="@../../css/HojaEstilos.css" text="Ver / Saldar Folio" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
