<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.controlsfx.control.textfield.CustomPasswordField?>
<?import org.controlsfx.control.textfield.CustomTextField?>

<!-- Importamos el StackPane para poder alternar de forma elegante si es necesario -->

<VBox alignment="CENTER" prefHeight="470.0" prefWidth="380.0" spacing="20.0" style="-fx-background-color: #f5f6fa; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Aparta_Suites_UQ.viewController.comunes.LoginViewController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
   <VBox alignment="CENTER" prefHeight="31.0" prefWidth="300.0">
      <children>
           <Label prefHeight="35.0" prefWidth="240.0" text="¡Bienvenido a Aparta">
               <font>
                   <Font name="System Bold" size="24.0" />
               </font>
            <cursor>
               <Cursor fx:constant="TEXT" />
            </cursor>
           </Label>
         <Label prefHeight="35.0" prefWidth="120.0" text="Suites UQ!">
            <font>
               <Font name="System Bold" size="24.0" />
            </font>
            <cursor>
               <Cursor fx:constant="TEXT" />
            </cursor>
         </Label>
      </children>
   </VBox>

    <VBox alignment="CENTER" spacing="5.0">
        <Label text="Ingresa tus credenciales para acceder" textFill="#7f8c8d" />
    </VBox>

    <VBox alignment="CENTER_LEFT" spacing="15.0">
        <Label style="-fx-font-weight: bold;" text="Usuario" textFill="#2c3e50" />
        <CustomTextField fx:id="txtUsuario" promptText="correo@ejemplo.com" style="-fx-background-radius: 5; -fx-padding: 8;" styleClass="validation-decorator" stylesheets="@../../css/HojaEstilos.css" />

        <Label style="-fx-font-weight: bold;" text="Contraseña" textFill="#2c3e50" />

        <!-- Contenedor StackPane para alternar entre el campo oculto y el visible -->
        <StackPane alignment="CENTER_RIGHT">
            <CustomTextField fx:id="txtPasswordVisible" promptText="••••••••" style="-fx-background-radius: 5; -fx-padding: 8;" visible="false" />
            <CustomPasswordField fx:id="txtPassword" promptText="••••••••" style="-fx-background-radius: 5; -fx-padding: 8;" styleClass="validation-decorator" stylesheets="@../../css/HojaEstilos.css" />
        </StackPane>
    </VBox>

    <Button fx:id="btnIngresar" maxWidth="1.7976931348623157E308" onAction="#handleLogin" prefHeight="37.0" prefWidth="101.0" styleClass="buttom-login" stylesheets="@../../css/HojaEstilos.css" text="Iniciar Sesión" />
   <HBox alignment="CENTER_LEFT" prefHeight="22.0" prefWidth="300.0" spacing="100.0">
      <children>
         <Button mnemonicParsing="false" prefHeight="23.0" prefWidth="59.0" style="-fx-padding: 5;" styleClass="buttom-login" stylesheets="@../../css/HojaEstilos.css" text="Portal" />
      
          <Label fx:id="lblMensaje" wrapText="true" stylesheets="@../../css/HojaEstilos.css" />
      </children>
      <VBox.margin>
         <Insets />
      </VBox.margin>
   </HBox>
</VBox>
